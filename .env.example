# AI provider API keys.
#
# These are OPTIONAL server-side fallbacks. The primary path is the per-user
# Settings -> AI provider screen, where each account adds its own provider, key,
# and model (or shares one with the other users). An env key only backs a
# provider after that provider is added in Settings; it does not silently enable
# one for every account.
#
# Copy this file to .env and fill in what you have.

# OpenRouter — one account/key for hundreds of models; the Settings model picker
# filters to those that accept images. Get a key: https://openrouter.ai/keys
#   Base URL default: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Optional fallback model when no model is saved for an OpenRouter provider.
# The Settings picker is preferred; qwen/qwen3.8-flash is a cheap vision model.
OPENROUTER_MODEL=qwen/qwen3.8-flash

# Groq — free tier, no credit card. Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Qwen Token Plan ("qwenplan") — Alibaba DashScope-compatible endpoint.
#   Multimodal text models read photos (your plan has no qwen-vl-* model).
#   Key from https://dashscope.console.aliyun.com  (starts with sk-)
#   Leave QWENPLAN_BASE_URL blank for standard DashScope. Region examples:
#     token-plan intl: https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
#     standard dashscope: https://dashscope.aliyuncs.com/compatible-mode/v1
QWENPLAN_API_KEY=
QWENPLAN_BASE_URL=
# qwen3.8-flash is ~12x cheaper than qwen3.8-max and estimates macros to the
# same accuracy (verified on identical inputs); max only helps on genuinely
# ambiguous plates. Used only when no model is saved for this provider.
QWENPLAN_MODEL=qwen3.8-flash

# Google AI Studio. NOTE (Oct 2026): new "AQ."-prefixed auth keys are being
# rejected by the Developer API with ACCESS_TOKEN_TYPE_UNSUPPORTED. You need a
# legacy "AIza..." key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI — gpt-4o-mini, ~$0.005 per meal.
OPENAI_API_KEY=

# Ollama — fully local, no account. Point at the machine running `ollama serve`.
OLLAMA_HOST=http://127.0.0.1:11434

# Server binding. Use 0.0.0.0 to reach it from your phone over LAN/Netbird.
# A non-loopback bind requires OIDC below, or MACROLOG_ALLOW_NO_AUTH=1 to accept
# a shared no-login instance (everyone who can reach it has full access).
MACROLOG_HOST=127.0.0.1
MACROLOG_PORT=8765
# MACROLOG_ALLOW_NO_AUTH=1

# Where the SQLite DB, photos, and session.key live (default: ./data).
# MACROLOG_DATA=/opt/macrolog/data
# Fallback timezone for server-side "today" when a request has no X-Client-TZ.
# MACROLOG_TZ=America/Los_Angeles
# Built-in HTTPS (only if you are not using Caddy); see deploy/make-cert.sh.
# MACROLOG_TLS_CERT=tls/macrolog.crt
# MACROLOG_TLS_KEY=tls/macrolog.key

# Optional Jev plausibility cross-check. When set, the first photo of every
# photo estimate is ALSO sent to api.typesafe.ai. Leave blank to disable.
# JEV_API_KEY=

# ---------------------------------------------------------------------------
# OpenID Connect login (optional — leave unset for single-user no-login mode)
# Works with Pocket ID, Authelia, Authentik, Keycloak, etc.
# When OIDC_ISSUER + OIDC_CLIENT_ID are set, every /api call requires a session
# and each user gets their own private meals/weights/targets/providers.
#   Create an OIDC client in Pocket ID > Administration > OIDC Clients:
#     redirect URI: https://your-host/auth/callback
#     scopes:       openid profile email
#   Then `pip install cryptography` on the server (RS256 verification).
# ---------------------------------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Externally-visible origin used to build the redirect_uri (behind Caddy this is
# usually auto-detected; set it if you hit "redirect_uri mismatch"):
OIDC_REDIRECT_BASE=
# Restrict sign-in to specific emails (comma-separated). Empty = any user your
# Pocket ID authenticates:
OIDC_ALLOWED_EMAILS=
# Session-cookie signing key: 32+ random characters, e.g. `openssl rand -base64 48`.
# Optional: when unset, a random key is generated once into data/session.key.
# Changing it signs everyone out.
MACROLOG_SESSION_SECRET=
# Development only: NEVER set in production (skips ID-token signature checks).
# OIDC_INSECURE_SKIP_SIGCHECK=
