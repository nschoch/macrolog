# Vision provider API keys. At least one is needed for real photo estimates;
# without any, the app runs on an offline placeholder estimator.
# Copy this file to .env and fill in what you have.

# Groq — free tier, no credit card. Recommended starting point.
#   Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Qwen Token Plan ("qwenplan") — Alibaba DashScope-compatible endpoint.
#   Multimodal text models read photos (your plan has no qwen-vl-* model).
#   Key from https://dashscope.console.aliyun.com  (starts with sk-)
#   Set QWENPLAN_BASE_URL to your plan's host; region examples:
#     token-plan intl: https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
#     standard dashscope: https://dashscope.aliyuncs.com/compatible-mode/v1
QWENPLAN_API_KEY=
QWENPL…m/v1
# qwen3.8-flash is ~12x cheaper than qwen3.8-max and estimates macros to the
# same accuracy (verified on identical inputs); max only helps on genuinely
# ambiguous plates. This env var OVERRIDES any model stored in the settings DB.
QWENPLAN_MODEL=qwen3.8-flash

*** Google AI Studio. NOTE (Oct 2026): new "AQ."-prefixed auth keys are being
# rejected by the Developer API with ACCESS_TOKEN_TYPE_UNSUPPORTED. You need a
# legacy "AIza..." key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

*** OpenAI — gpt-4o-mini, ~$0.005 per meal.
OPENAI_API_KEY=

*** Ollama — fully local, no account. Point at the machine running `ollama serve`.
OLLAMA_HOST=http://127.0.0.1:11434

# Server binding. Use 0.0.0.0 to reach it from your phone over LAN/Netbird.
MACROLOG_HOST=127.0.0.1
MACROLOG_PORT=8765

# ---------------------------------------------------------------------------
# OpenID Connect login (optional — leave unset for single-user no-login mode)
# Works with Pocket ID, Authelia, Authentik, Keycloak, etc.
# When OIDC_ISSUER + OIDC_CLIENT_ID are set, every /api call requires a session
# and each user gets their own private meals/weights/targets.
#   Create an OIDC client in Pocket ID > Administration > OIDC Clients:
#     redirect URI: https://your-host/auth/callback
#     scopes:       openid profile email
#   Then `pip install cryptography` on the server (RS256 verification).
# ---------------------------------------------------------------------------
OIDC_ISSUER=
***
***
# Externally-visible origin used to build the redirect_uri (behind Caddy this is
# usually auto-detected; set it if you hit "redirect_uri mismatch"):
OIDC_REDIRECT_BASE=
# Restrict sign-in to specific emails (comma-separated). Empty = any user your
# Pocket ID authenticates:
OIDC_ALLOWED_EMAILS=
